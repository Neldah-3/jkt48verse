# ============================================================
# JKT48Verse — contoh environment PRODUKSI
# Salin ke .env lalu isi nilai asli. Jangan commit .env.
# ============================================================
ENV=prod

# Wajib >= 32 karakter acak (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database: Supabase (Direct Connection / pooler) ---
# Catatan: aplikasi ini memakai asyncpg → boleh langsung postgresql://
DATABASE_URL=postgresql://postgres.zbqjgjdwyumrxpkudwgv:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5433/postgres
DB_MAX_POOL_SIZE=10

# --- Redis: Upstash ---
# Format yang benar: rediss://default:PASSWORD@NAMA.upstash.io:6379
# (ambil dari dashboard Upstash → "Connect" → "UPSTASH_REDIS_URL")
REDIS_URL=rediss://default:PASSWORD@welcomed-gnat-186959.upstash.io:6379

# --- URL publik ---
FRONTEND_URL=https://jkt48verse-web.vercel.app
API_BASE_URL=https://jkt48verse-api.vercel.app/api
# CORS origins (dipisah koma), hanya https di produksi
ORIGINS=https://jkt48verse-web.vercel.app

# Set true HANYA bila API berada di belakang reverse proxy terpercaya (Cloudflare)
# yang menimpa header X-Forwarded-For / CF-Connecting-IP. Jika false, IP klien
# diambil dari koneksi langsung sehingga header palsu tidak bisa melewati
# rate-limiting.
TRUST_PROXY_HEADERS=true

# --- Email OTP via Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
EMAIL_FROM=JKT48Verse <no-reply@domain-anda.com>
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# --- AI: BANYAK api key, TETAP 1 base URL & 1 model ---
# Router anti-limit: AI chat (AI Search) dan block chat (moderasi AI) memakai
# kumpulan key ini secara round-robin. Key yang kena limit (429) atau error
# diistirahatkan sementara, lalu permintaan lanjut otomatis ke key berikutnya.
#
# CARA TERMUDAH: satu baris, pisahkan dengan koma.
LLM_API_KEYS=
# Format lama tetap didukung (digabung, bukan menggantikan):
LLM_API_KEY=
# Format nomor juga didukung (LLM_API_KEY_1 .. LLM_API_KEY_12):
LLM_API_KEY=
# Base URL & model sengaja cuma SATU supaya tidak mudah error & hemat token.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
# Lama sebuah key diistirahatkan setelah kena limit / error server.
LLM_KEY_COOLDOWN_SECONDS=60
# Key invalid (401/403) diistirahatkan lebih lama, lalu dicoba lagi otomatis.
LLM_KEY_INVALID_COOLDOWN_SECONDS=900
# 0 = coba semua key sampai ada yang berhasil.
LLM_MAX_ATTEMPTS=0
# Moderasi AI untuk block chat (set false bila ingin hemat token).
LLM_MODERATION_ENABLED=true
LLM_MODERATION_TIMEOUT_SECONDS=8

# ----------------------------------------------------------------------------
# KREDENSIAL STAFF — 3 Admin + 10 Moderator (ALL-OR-NOTHING)
#
# Aturan wajib:
#   1. Satu slot = 4 nilai sekaligus: _USERNAME + _EMAIL + _PASSWORD +
#      _ACCESS_CODE.
#   2. Kalau SATU saja kosong -> slot = false (NONAKTIF) dan akun tersebut
#      TIDAK BISA LOGIN sampai keempatnya lengkap.
#   3. Nilai harus diketik 100% PERSIS saat login: besar/kecil huruf, spasi,
#      dan karakter apa pun ikut terhitung (tidak dinormalisasi/lower-case).
#   4. Tidak wajib mengisi semua slot. Yang tidak dipakai biarkan kosong
#      (= false). Yang diisi WAJIB lengkap 4/4.
#
# Akun dibuat / disinkronkan oleh:  python scripts/seed.py --staff
# Pantau status slot di:            GET /api/admin/credentials
# ----------------------------------------------------------------------------
# --- Admin 1 (lengkapi 4 baris ini, atau kosongkan semua = false) ---
ADMIN_1_USERNAME=
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_1_ACCESS_CODE=
# --- Admin 2 (lengkapi 4 baris ini, atau kosongkan semua = false) ---
